# Copy to .env for local development. Never commit a real .env.
# Production values live in the host's service variables (Railway: see
# DEPLOYMENT.md, which lists every variable and the value each one gets).

NODE_ENV=development
PORT=3001

# --- database ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=
DB_NAME=valle_park
# TLS to the database. Production refuses "false" at boot.
#   true       verify the server certificate (Azure, RDS, any public endpoint)
#   no-verify  encrypt, but accept a self-signed certificate (Railway Postgres
#              over the private network ships one)
#   false      plain TCP, local development only
DB_SSL=false

# --- staff sessions ---
# Signs the httpOnly staff session JWT. In production this MUST be set to 32+
# random characters or the API refuses to boot, because the development
# fallback key is published in this repository.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Signs guest ticket, waiver and QR links (at least 32 characters). Independent of
# JWT_SECRET so operator sessions can be rotated without breaking links already sent.
# To rotate: move the old value to TICKET_SECRET_PREVIOUS, set a new TICKET_SECRET.
TICKET_SECRET=
TICKET_SECRET_PREVIOUS=
STAFF_COOKIE_NAME=valle_staff

# --- browser origins ---
# Exact origins, comma separated. Production must be https and must not be "*",
# because the session cookie is sent with credentials.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Set true when running behind a reverse proxy (Railway, nginx, Azure Front
# Door) so rate limiting sees the real client IP instead of the proxy's.
# Always on when NODE_ENV=production.
TRUST_PROXY=false

# Online payment: none (default, pay on arrival only) | sandbox (stand-in checkout
# served by the API; development and tests only). A real gateway adapter is added
# in src/payments once the park has a merchant account.
PAYMENT_PROVIDER=none
PAYMENT_TICKET_GRACE_MIN=120

# Sentry (optional): error and performance monitoring, off when unset.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
